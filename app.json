{
  "expo": {
    "name": "HabitStreak",
    "slug": "HabitStreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "newArchEnabled": false,
      "supportsTablet": true,
      "bundleIdentifier": "com.thuogpx.habitstreak",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "newArchEnabled": true,
      "package": "com.thuogpx.habitstreak"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9280277943761953/5710617512",
          "iosAppId": "ca-app-pub-9280277943761953/2688034204"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d758b55b-0447-4223-9f7a-6d4bdb1c51ca"
      }
    }
  }
}
